{
  "name": "kraft-inventar",
  "private": true,
  "description": "Vorrat-App. Die App selbst braucht keinen Build; package.json dient nur den Tests.",
  "type": "module",
  "scripts": {
    "test": "mocha \"tests/unit/**/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kraft-inventar \"mocha --timeout 20000 tests/rules/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "2.0.7",
    "firebase": "9.23.0",
    "firebase-tools": "12.9.1",
    "mocha": "^10.8.2"
  },
  "overrides": {
    "universal-analytics": "0.5.3"
  }
}
